# Certainly configuration — copy to `.env` and edit as needed.
# Every value is optional; defaults are shown. Variables are prefixed
# CERTAINLY_ so they don't collide with other services.

# --- Deployment (docker-compose.prod.yml) ---
# Container image tag to run in production. Defaults to "latest"; pin a
# specific version (e.g. 1.0.0) for reproducible deployments.
CERTAINLY_VERSION=latest

# --- Web / API ---
CERTAINLY_HOST=0.0.0.0
CERTAINLY_PORT=8000
# Comma-separated list of allowed cross-origin origins. Empty by default (the
# bundled UI is same-origin). Set "*" to allow all, or list specific origins.
# Leave empty unless you intend to expose the API to other web origins.
CERTAINLY_CORS_ALLOW_ORIGINS=

# --- Scan limits ---
# Maximum number of targets accepted in a single request.
CERTAINLY_MAX_TARGETS_PER_REQUEST=10
# How many hosts a worker analyzes in parallel per job.
CERTAINLY_SCAN_CONCURRENCY=10
# Parallel TLS probes (protocols/ciphers) per host.
CERTAINLY_PROBE_CONCURRENCY=12
# Per-connection socket timeout (seconds).
CERTAINLY_CONNECT_TIMEOUT=8
# Port used when a target doesn't specify one.
CERTAINLY_DEFAULT_PORT=443

# --- Caching ---
# How long host results are cached, in seconds (default 24h). 0 disables.
CERTAINLY_CACHE_TTL_SECONDS=86400

# --- Job queue / storage ---
CERTAINLY_REDIS_URL=redis://localhost:6379/0
# How long finished job records are retained (seconds, default 7 days).
CERTAINLY_JOB_RESULT_TTL_SECONDS=604800
# Maximum wall-clock time for a single scan job (seconds).
CERTAINLY_JOB_TIMEOUT_SECONDS=300
# Run jobs synchronously in-process (no worker needed). For dev/testing only.
CERTAINLY_USE_INLINE_WORKER=false
